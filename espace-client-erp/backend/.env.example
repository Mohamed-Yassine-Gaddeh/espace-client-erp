SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///espace_client.db
CORS_ORIGINS=http://localhost:4200

# --- ERP : à remplacer par les vraies valeurs de votre ERP ---
ERP_BASE_URL=https://votre-erp.example.com/api
ERP_API_KEY=your-erp-api-key
ERP_TIMEOUT_SECONDS=10

# --- Email (envoi des liens de reset mot de passe) ---
# Laissez ces valeurs par défaut (MAIL_USERNAME/MAIL_PASSWORD vides) pour le
# développement local SANS boîte mail : le lien de réinitialisation sera
# affiché directement dans le terminal backend ET dans l'interface (page
# "Mot de passe oublié"), aucun email réel n'est requis pour tester.
#
# Pour envoyer de VRAIS emails, remplissez avec un compte SMTP réel, par exemple :
#   - Gmail : MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587,
#             MAIL_USERNAME=votre-adresse@gmail.com,
#             MAIL_PASSWORD=un "mot de passe d'application" Google (pas votre mdp normal)
#   - Mailtrap (boîte de test, gratuite) : voir https://mailtrap.io
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
FRONTEND_RESET_URL=http://localhost:4200/reset-password

# --- Chatbot (optionnel) ---
# Laissez vide pour utiliser le chatbot en mode "réponses depuis la base"
# (fonctionne sans clé). Renseignez une clé pour des réponses reformulées par Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
